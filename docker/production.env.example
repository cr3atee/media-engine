MEDIAENGINE_IMAGE=mediaengine:0.1.0
DATABASE_URL=
LOG_LEVEL=INFO

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
API_STOP_GRACE_PERIOD=30s
ADMIN_API_ENABLED=true
ADMIN_API_KEY=
ADMIN_CURSOR_SIGNING_KEY=
AUTH_ACCESS_TOKEN_SECRET=

WORKER_REPLICAS=2
WORKER_POLL_INTERVAL_SECONDS=300
WORKER_POLL_RETRY_COUNT=1
WORKER_POLL_RETRY_DELAY_SECONDS=5
WORKER_POLL_TIMEOUT_SECONDS=60
WORKER_METRICS_REFRESH_SECONDS=15
WORKER_HEALTH_MAX_AGE_SECONDS=60
WORKER_STOP_GRACE_PERIOD=180s
SCHEDULER_LEASE_TTL_SECONDS=150

POLLING_RETENTION_INTERVAL_SECONDS=86400
POLLING_RETENTION_RETAIN_FOR_SECONDS=7776000
POLLING_RETENTION_KEEP_LATEST_PER_INTEGRATION=10
POLLING_RETENTION_BATCH_SIZE=500
POLLING_RETENTION_RETRY_COUNT=1
POLLING_RETENTION_RETRY_DELAY_SECONDS=5
POLLING_RETENTION_TIMEOUT_SECONDS=60

ALERTING_ENABLED=true
ALERTING_EVALUATION_INTERVAL_SECONDS=30
ALERTING_DASHBOARD_WINDOW_SECONDS=86400
ALERTING_REMINDER_INTERVAL_SECONDS=1800

NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.9.1
METRICS_BIND_ADDRESS=127.0.0.1
METRICS_PORT=9100
