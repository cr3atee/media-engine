APP_NAME=mediaengine
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mediaengine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/mediaengine

LOG_LEVEL=INFO
SCHEDULER_TIMEZONE=UTC
SCHEDULER_TICK_SECONDS=0.25
SCHEDULER_LEASE_ENABLED=false
SCHEDULER_OWNER_ID=
SCHEDULER_LEASE_TTL_SECONDS=300

ALERTING_ENABLED=false
ALERTING_EVALUATION_INTERVAL_SECONDS=30
ALERTING_DASHBOARD_WINDOW_SECONDS=86400
ALERTING_REMINDER_INTERVAL_SECONDS=1800

POLLING_RETENTION_ENABLED=false
# Required when POLLING_RETENTION_ENABLED=true:
# POLLING_RETENTION_INTERVAL_SECONDS=86400
# POLLING_RETENTION_RETAIN_FOR_SECONDS=7776000
# POLLING_RETENTION_KEEP_LATEST_PER_INTEGRATION=10
# POLLING_RETENTION_BATCH_SIZE=500
# POLLING_RETENTION_RETRY_COUNT=1
# POLLING_RETENTION_RETRY_DELAY_SECONDS=5
# POLLING_RETENTION_TIMEOUT_SECONDS=60

ADMIN_API_ENABLED=false
ADMIN_API_KEY=replace-with-a-local-admin-key
ADMIN_TEST_BYPASS_ENABLED=false
ADMIN_API_DOCS_ENABLED=true
ADMIN_DEFAULT_PAGE_SIZE=50
ADMIN_MAXIMUM_PAGE_SIZE=100
ADMIN_REQUEST_ID_MAX_LENGTH=128
ADMIN_CURSOR_SIGNING_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=true
TELEGRAM_MAXIMUM_MESSAGE_LENGTH=4096
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_DRY_RUN=true
TELEGRAM_ALLOW_LIVE_DELIVERY=false
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_ALLOWED_DESTINATION_IDS=[]
TELEGRAM_DELIVERY_BATCH_SIZE=10
TELEGRAM_PUBLICATION_LEASE_SECONDS=60
TELEGRAM_MAXIMUM_ATTEMPTS=5
TELEGRAM_INITIAL_RETRY_SECONDS=30
TELEGRAM_MAXIMUM_RETRY_SECONDS=1800

# Playerok authenticated collector secrets are tenant/integration scoped.
# Store only env://NAME in marketplace_integrations. Inject the JSON secret as:
# MEDIAENGINE_MARKETPLACE_SECRET_<TENANT_HEX>_<INTEGRATION_HEX>_<NAME>=
# Never commit real browser cookies or tokens to this file.
MARKETPLACE_SECRETS_ENV_FILE=.marketplace-secrets.env
